# --- core ---
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/defineux

# --- clerk ---
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# --- cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- resend (optional in dev; falls back to console adapter) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=DefineUX <no-reply@defineux.app>

# --- web app ---
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- workflow tuning ---
INACTIVITY_CRON=*/15 * * * *
REMINDER_CRON=0 * * * *
