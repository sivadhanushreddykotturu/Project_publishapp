# Server
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/launchops?retryWrites=true&w=majority

# Clerk (auth) — replace with real keys from your Clerk instance dashboard.
# The publishable key below is a syntactically valid PLACEHOLDER (decodes to a fake
# frontend API host) so the app boots locally without real credentials; it will not
# authenticate any real user.
CLERK_SECRET_KEY=sk_test_replace_with_real_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_WEBHOOK_SECRET=whsec_xxx

# Cloudflare R2 (S3-compatible file storage)
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=launchops-files
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://files.launchops.app

# Resend (email)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=LaunchOps <notifications@launchops.app>

# Razorpay (payments + UPI payouts)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
RAZORPAY_X_ACCOUNT_NUMBER=xxx

# Google Play Developer API (API-mode integration, optional in v1)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_API_MODE_ENABLED=false

# Workflow defaults
DEFAULT_MIN_TESTERS=14
STEP1_INACTIVITY_HOURS=48
INACTIVITY_CRON_SCHEDULE=*/15 * * * *
REMINDER_CRON_SCHEDULE=0 * * * *

# Observability
SENTRY_DSN=
LOG_LEVEL=info
